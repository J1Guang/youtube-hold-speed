{
  "manifest_version": 3,
  "name": "YouTube Hold Speed · 长按三倍速",
  "version": "1.0.0",
  "description": "像 Bilibili 一样长按右方向键，以 3 倍速播放 YouTube；松开恢复原速，短按仍然快进。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
