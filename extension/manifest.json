{
  "manifest_version": 3,
  "name": "Hold Speed for YouTube · 长按倍速",
  "version": "1.1.0",
  "description": "长按右方向键，以 2×、3× 或 4× 播放 YouTube；松开恢复原速。暂停时按住临时播放，松开继续暂停。",
  "permissions": ["storage"],
  "action": {
    "default_title": "Hold Speed · 设置长按倍速",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "homepage_url": "https://github.com/J1Guang/youtube-hold-speed",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
